&CONTROL
   calculation  = 'relax'
   pseudo_dir = '/home/mark/pseudo_library/',
   outdir = './tmp/',
   forc_conv_thr = 4D-4,
   nstep = 100
   prefix = 'Ni4-tetra'
/
&SYSTEM
   ibrav = 0,
   nat = 4,
   ntyp = 1,
   ecutwfc = 40.4
   ecutrho = 500
   smearing = 'gaussian',
   occupations = 'smearing',
   degauss = 0.01D0,
   vdw_corr= 'grimme-d3',
   nspin = 2,
   starting_magnetization(1) = 0.6,
/
&ELECTRONS
    mixing_beta = 0.5
    electron_maxstep = 500,
    mixing_mode = 'local-TF',
/
&IONS
   ion_dynamics = 'bfgs'
/
ATOMIC_SPECIES
   Ni  58.6934 ni_pbe_v1.4.uspp.F.UPF
   
K_POINTS gamma

CELL_PARAMETERS angstrom
15.00000000000000 0.00000000000000 0.00000000000000
0.00000000000000 15.00000000000000 0.00000000000000
0.00000000000000 0.00000000000000 15.00000000000000

