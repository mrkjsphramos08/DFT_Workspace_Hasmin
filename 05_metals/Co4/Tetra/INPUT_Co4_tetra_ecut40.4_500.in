&CONTROL
   calculation  = 'relax'
   pseudo_dir = '/home/mark/pseudo_library/',
   outdir = './tmp/',
   forc_conv_thr = 4D-4,
   nstep = 100
   prefix = 'Co4-tetra'
/
&SYSTEM
   ibrav = 0,
   nat = 4,
   ntyp = 1,
   ecutwfc = 40.4
   ecutrho = 500
   smearing = 'gaussian',
   occupations = 'smearing',
   degauss = 0.01D0,
   vdw_corr= 'grimme-d3',
   nspin = 2,
   starting_magnetization(1) = 0.8,
/
&ELECTRONS
    mixing_beta = 0.5
    electron_maxstep = 500,
    mixing_mode = 'local-TF',
/
&IONS
   ion_dynamics = 'bfgs'
/
ATOMIC_SPECIES
   Co 58.933194  co_pbe_v1.2.uspp.F.UPF
   
K_POINTS gamma

