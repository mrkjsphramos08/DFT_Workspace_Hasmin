&control
   calculation='relax',
   pseudo_dir = '/home/mark/pseudo_library/',
   outdir= './tmp'
   prefix='lco',
   forc_conv_thr = 4D-4,
   dipfield = .true.
   nstep = 100
 /
&system
   ibrav = 0,
   nat= 96,
   ntyp= 3,
   ecutwfc = 40.4,
   ecutrho = 500,
   occupations='smearing',
   smearing='gaussian',
   degauss = 0.01D0,
   vdw_corr= 'grimme-d3',
