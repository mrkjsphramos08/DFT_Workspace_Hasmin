&CONTROL
   calculation = 'vc-relax'
   pseudo_dir  = '/home/mark/pseudo_library/'
   outdir      = './tmp'
   prefix      = 'lcobulk'
   forc_conv_thr = 4D-4
   nstep       = 100
/
&SYSTEM
   ibrav = 0
   nat   = 12
   ntyp  = 3
   ecutwfc = 40.4
   ecutrho = 500.0
   occupations = 'smearing'
   smearing    = 'gaussian'
   degauss     = 0.01D0
   vdw_corr    = 'grimme-d3'
   nspin       = 2
   starting_magnetization(2) = 0.1
/
&ELECTRONS
   mixing_beta = 0.2
   electron_maxstep = 500
   mixing_mode = 'local-TF'
/
&IONS
   ion_dynamics = 'bfgs'
/
&CELL
   cell_dynamics = 'bfgs'
/
